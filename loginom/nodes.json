    "name": "Калькулятор",
    "engine_type": "TBGCalcData",
    "details": {
      "expressions": [
        {
          "name": "fueltype_code",
          "type": "dtInteger",
          "formula": "If(fueltype = \"gas\", 0, 1)"
        },
        {
          "name": "aspiration_code",
          "type": "dtInteger",
          "formula": "If(aspiration = \"std\", 0, 1)"
        },
        {
          "name": "doornumber_code",
          "type": "dtInteger",
          "formula": "If(doornumber = \"two\", 2, 4)"
        },
        {
          "name": "enginelocation_code",
          "type": "dtInteger",
          "formula": "If(enginelocation = \"front\", 0, 1)"
        },
        {
          "name": "drivewheel_code",
          "type": "dtInteger",
          "formula": "If(drivewheel = \"rwd\", 0, If(drivewheel = \"fwd\", 1, 2))"
        },
        {
          "name": "carbody_code",
          "type": "dtInteger",
          "formula": "If(carbody = \"sedan\", 0, If(carbody = \"hatchback\", 1, If(carbody = \"wagon\", 2, If(carbody = \"hardtop\", 3, 4))))"
        },
        {
          "name": "enginetype_code",
          "type": "dtInteger",
          "formula": "If(enginetype = \"ohc\", 0, If(enginetype=\"ohcf\", 1, If(enginetype=\"ohcv\", 2, If(enginetype=\"dohc\", 3, If(enginetype=\"l\", 4, If(enginetype=\"rotor\", 5, 6))))))"
        },
        {
          "name": "cylindernumber_code",
          "type": "dtInteger",
          "formula": "If(cylindernumber=\"four\",4,If(cylindernumber=\"six\",6,If(cylindernumber=\"five\",5,If(cylindernumber=\"eight\",8,If(cylindernumber=\"two\",2,If(cylindernumber=\"twelve\",12,3))))))"
        },
        {
          "name": "fuelsystem_code",
          "type": "dtInteger",
          "formula": "If(fuelsystem=\"mpfi\",0,If(fuelsystem=\"2bbl\",1,If(fuelsystem=\"mfi\",2,If(fuelsystem=\"1bbl\",3,If(fuelsystem=\"spfi\",4,If(fuelsystem=\"4bbl\",5,If(fuelsystem=\"idi\",6,7)))))))"
        }
      ]
    }
  },
